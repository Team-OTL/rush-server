# cp .env.example .env 후 값을 바꿔서 쓰세요. (.env는 git에 올리지 않습니다)
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-bytes

# rush-gateway: actuator 관리용 엔드포인트(health 제외)에 접근할 수 있는 IP 대역(CIDR, 콤마 구분)
GATEWAY_ADMIN_ALLOWED_IPS=127.0.0.1/32,::1/128
# rush-gateway: 앞단 LB/프록시 대역(CIDR). 이 대역에서 온 요청만 X-Forwarded-For를 믿습니다.
TRUSTED_PROXIES=
# rush-gateway: CORS를 허용할 Origin(콤마 구분)
CORS_ALLOWED_ORIGINS=
